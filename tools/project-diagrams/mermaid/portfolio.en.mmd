%% How this site works: content files feed a React app; a push to GitHub makes Vercel build the live site.
flowchart TD
  J["content/*.json<br/>EN + ES"]
  R["React app<br/>Vite, TypeScript<br/>Tailwind"]
  SP["spiral menu<br/>three.js"]
  LV["list view<br/>(phones)"]
  P["opened panel"]
  GL["dotted<br/>mountain<br/>landscape"]
  B["corner badge"]
  PR["photo reel"]
  subgraph DEP[" "]
    direction LR
    GH["GitHub<br/>(push)"] --> V["Vercel<br/>(build)"] --> L["live site"]
  end
  J --> R
  R --> SP
  R --> LV
  SP --> P
  P -.->|behind| GL
  SP --> B --> PR
  GL ~~~ DEP
  PR ~~~ DEP
  classDef top stroke:#ededed,stroke-width:2px
  class R top