%% Planificador de CPU: un archivo de tareas, cinco algoritmos (lista en caja), un orden de ejecucion impreso.
flowchart TD
  F["schedule.txt<br/>nombre, prioridad, ráfaga"]
  S["planificador"]
  subgraph ALG["5 algoritmos"]
    direction TB
    A1["FCFS"]
    A2["prioridad"]
    A5["SJF"]
    A3["round robin<br/>quantum 10"]
    A4["prioridad<br/>con rr"]
    A1 ~~~ A3
    A2 ~~~ A4
    A5 ~~~ A4
  end
  O["orden de ejecución<br/>impreso"]
  F --> S --> ALG --> O
  classDef top stroke:#ededed,stroke-width:2px
  class S top